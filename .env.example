AP_DB_PATH=app_portfolio.db

# Contract reading: "replay" (offline demo), "anthropic" (Claude API), or "foundry" (Claude on Microsoft Foundry)
AP_LLM_PROVIDER=replay
AP_MODEL=claude-opus-5-5
AP_RECORD=false

# Sign-in: demo (default) | oidc (Microsoft Entra ID or any OIDC provider)
AP_AUTH=demo
# AP_OIDC_METADATA_URL=https://login.microsoftonline.com/<tenant-id>/v2.0/.well-known/openid-configuration
# AP_OIDC_CLIENT_ID=
# AP_OIDC_CLIENT_SECRET=
# AP_SESSION_SECRET=
# AP_APPROVER_ROLE=AppPortfolio.Approver

# Mission Control: send retirement work to Backlog Pilot's intake inbox (same token as BP_SUITE_TOKEN)
# AP_BACKLOG_URL=http://127.0.0.1:8000
# AP_LEADERSHIP_URL=http://127.0.0.1:8010
# AP_SUITE_TOKEN=
# AP_PUBLIC_URL=http://127.0.0.1:8040
# MISSION_CONTROL_APPS=Backlog Pilot=http://127.0.0.1:8000, Leadership Pilot=http://127.0.0.1:8010, PLM Insight=http://127.0.0.1:8020, Support Pilot=http://127.0.0.1:8030, App Portfolio=http://127.0.0.1:8040

# Legacy apps on Active Directory: read-only group counts over LDAPS (demo directory if unset)
# AP_LDAP_URL=ldaps://dc01.corp.example.com:636
# AP_LDAP_BIND_DN=CN=svc-mission-control,OU=Service Accounts,DC=corp,DC=example,DC=com
# AP_LDAP_PASSWORD=
# AP_LDAP_ALLOW_INSECURE=false
